# MinIO (used when DEV_MODE=true)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_INNER_PORT=9001
MINIO_OUTER_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_INNER_DATA_PORT=9000

# CVAT (optional – for annotation pipeline)
CVAT_HOST=http://cvat:8080
CVAT_USER=
CVAT_PASSWORD=

# S3 / object storage (used when DEV_MODE is not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://s3.example.com
SSE_CUSTOM_KEY=
SSE_CUSTOM_ALGORITHM=AES256
S3_BUCKET=your-bucket
EXPORT_S3_BUCKET=your-export-bucket

# Frontend / backend
S3_HOST=minio
S3_PORT=9000
FRONTEND_INNER_PORT=9000
FRONTEND_OUTER_PORT=9999
FRONTEND_FILE_ACCEPT=png,jpg,jpeg

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_INNER_PORT=5432
POSTGRES_OUTER_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres

# Keycloak
KC_OUTER_PORT=8080
KC_INNER_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_REALM=medforce
KEYCLOAK_FRONTEND_CLIENT=medforce_client
KEYCLOAK_DIVIDED_STAGES_ROLE=doctor_clinic1
KEYCLOAK_WITHOUT_SPLITTING_ROLE=doctor_clinic2
KEYCLOAK_ADMIN_ROLE=admin
KC_HEALTH_ENABLED=true

# Email (optional – for notifications)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# App URL (optional – for links in emails)
APP_BASE_URL=http://localhost:9999
